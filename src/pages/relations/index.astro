---
import Base from '../../layouts/Base.astro';
import relationsData from '../../data/relations.json';
import charactersData from '../../data/characters.json';
import worksData from '../../data/works.json';

const base = import.meta.env.BASE_URL;
const { graphs, types } = relationsData;
const charById = Object.fromEntries(charactersData.characters.map((c) => [c.id, c]));
const workById = Object.fromEntries(worksData.works.map((w) => [w.id, w]));

const VW = 1000;
const VH = 560;
const NH = 34;

const built = graphs.map((g) => {
  const nodes = g.nodes.map((n) => {
    const name = n.name ?? charById[n.id]?.name ?? n.id;
    const w = Math.max(84, name.length * 15 + 22);
    return { ...n, name, w, linked: !n.name && !!charById[n.id] };
  });
  const pos = Object.fromEntries(nodes.map((n) => [n.id, n]));
  const edges = g.edges
    .map((e) => {
      const a = pos[e.from];
      const b = pos[e.to];
      if (!a || !b) return null;
      return {
        ...e,
        x1: a.x,
        y1: a.y,
        x2: b.x,
        y2: b.y,
        mx: (a.x + b.x) / 2,
        my: (a.y + b.y) / 2,
      };
    })
    .filter(Boolean);
  return { ...g, nodes, edges };
});
---

<Base title="人物相関図" description="作品ごとの人物相関図。読了にした作品の図だけが表示されます。">
  <h1>人物相関図</h1>
  <p class="muted">
    作品ごとに関係を図にしました。<strong>読了にしていない作品のタブと図は表示されません</strong>。
    右上の📖から読んだ作品にチェックを入れてください。
  </p>

  <div class="chips tabs" id="tabs">
    {built.map((g, i) => (
      <button class={`filter-chip${i === 0 ? ' active' : ''}`} data-graph={g.work} data-sp={g.work} data-sp-hide>
        {g.label}
      </button>
    ))}
  </div>

  <div class="chips legend">
    {Object.entries(types).map(([k, t]) => (
      <span class="legend-item">
        <svg width="30" height="10" aria-hidden="true"><line x1="1" y1="5" x2="29" y2="5" stroke={t.color} stroke-width={t.width} stroke-dasharray={t.dash} stroke-linecap="round" /></svg>
        {t.label}
      </span>
    ))}
  </div>

  {built.map((g, i) => (
    <section class="graph-block" data-graph={g.work} data-sp={g.work} data-sp-hide hidden={i !== 0}>
      <h2 class="section-title">
        <a href={`${base}works/${g.work}/`}>{workById[g.work]?.title ?? g.label}</a>
      </h2>
      <p class="caption muted">{g.caption}</p>
      <div class="scroll-x graph-wrap card">
        <svg viewBox={`0 0 ${VW} ${VH}`} class="graph-svg" role="img" aria-label={`${g.label} の人物相関図`}>
          {g.edges.map((e) => (
            <g class="edge">
              <line
                x1={e.x1}
                y1={e.y1}
                x2={e.x2}
                y2={e.y2}
                stroke={types[e.type].color}
                stroke-width={types[e.type].width}
                stroke-dasharray={types[e.type].dash}
                stroke-linecap="round"
                opacity="0.85"
              />
              {e.label && (
                <text x={e.mx} y={e.my - 4} class="edge-label" text-anchor="middle">{e.label}</text>
              )}
            </g>
          ))}
          {g.nodes.map((n) => (
            <g class="node">
              <rect
                x={n.x - n.w / 2}
                y={n.y - NH / 2}
                width={n.w}
                height={NH}
                rx="8"
                class={n.linked ? 'node-box node-linked' : 'node-box'}
              />
              <text x={n.x} y={n.y + 5} class="node-label" text-anchor="middle">{n.name}</text>
            </g>
          ))}
        </svg>
      </div>
      <div class="node-links">
        {g.nodes.filter((n) => n.linked).map((n) => (
          <a class="node-link" href={`${base}characters/${n.id}/`}>{n.name}</a>
        ))}
      </div>
    </section>
  ))}

  <p class="muted" id="none-note" hidden>
    表示できる相関図がありません。右上の📖から、読んだ作品にチェックを入れてください。
  </p>

  <p class="muted small">
    枠が濃い人物は<a href={`${base}characters/`}>人物名鑑</a>に個別ページがあります。薄い枠は図の中だけで示している人物・組織です。
  </p>
</Base>

<script is:inline>
  (() => {
    const tabs = document.getElementById('tabs');
    const blocks = [...document.querySelectorAll('.graph-block')];

    const visibleTabs = () => [...tabs.querySelectorAll('.filter-chip')].filter((b) => !b.classList.contains('sp-hidden'));

    const show = (key) => {
      blocks.forEach((b) => (b.hidden = b.dataset.graph !== key));
      tabs.querySelectorAll('.filter-chip').forEach((b) => b.classList.toggle('active', b.dataset.graph === key));
    };

    const sync = () => {
      const vs = visibleTabs();
      document.getElementById('none-note').hidden = vs.length > 0;
      if (vs.length === 0) {
        blocks.forEach((b) => (b.hidden = true));
        return;
      }
      const active = vs.find((b) => b.classList.contains('active')) || vs[0];
      show(active.dataset.graph);
    };

    tabs.addEventListener('click', (e) => {
      const b = e.target.closest('.filter-chip');
      if (!b || b.classList.contains('sp-hidden')) return;
      show(b.dataset.graph);
    });

    document.addEventListener('kishi:read', sync);
    window.addEventListener('DOMContentLoaded', sync);
  })();
</script>

<style>
  h1 { margin-bottom: 0.3rem; }
  .tabs { margin: 16px 0 10px; }
  .legend { gap: 14px; margin-bottom: 14px; font-size: 0.8rem; }
  .legend-item { display: inline-flex; align-items: center; gap: 6px; }
  .caption { font-size: 0.86rem; margin-top: -0.5rem; }
  .graph-wrap { padding: 8px; }
  .graph-svg { display: block; min-width: 940px; width: 100%; }

  .node-box {
    fill: var(--surface);
    stroke: var(--line);
    stroke-width: 1.5;
  }
  .node-linked { stroke: var(--ink-2); stroke-width: 2.5; }
  .node-label { fill: var(--ink); font-size: 15px; font-weight: 700; }
  .edge-label {
    fill: var(--ink-2);
    font-size: 12px;
    paint-order: stroke;
    stroke: var(--surface);
    stroke-width: 4;
    stroke-linejoin: round;
  }

  .node-links {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin: 12px 0 6px;
  }
  .node-link {
    font-size: 0.82rem;
    text-decoration: none;
    border: 1px solid var(--line);
    border-radius: 999px;
    padding: 3px 12px;
  }
  .node-link:hover { border-color: var(--accent); color: var(--accent); }
  .small { font-size: 0.82rem; }
  .section-title a { text-decoration: none; }
  .section-title a:hover { color: var(--accent); }
</style>
