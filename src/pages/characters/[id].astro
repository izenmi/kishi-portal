---
import Base from '../../layouts/Base.astro';
import WorkSymbol from '../../components/WorkSymbol.astro';
import charactersData from '../../data/characters.json';
import worksData from '../../data/works.json';

export function getStaticPaths() {
  return charactersData.characters.map((c) => ({ params: { id: c.id }, props: { c } }));
}

const { c } = Astro.props;
const base = import.meta.env.BASE_URL;
const { sides, characters } = charactersData;
const byId = Object.fromEntries(worksData.works.map((w) => [w.id, w]));
const work = byId[c.work];
const mates = characters.filter((x) => x.work === c.work && x.id !== c.id);
---

<Base title={c.name} description={`${c.name}(『${work.title}』)の人物紹介。読了にした作品の情報だけが表示されます。`}>
  <nav class="crumbs muted">
    <a href={`${base}characters/`}>人物名鑑</a> ›
    <a href={`${base}works/${work.id}/`}>{work.title}</a> › {c.name}
  </nav>

  <header class="char-head">
    <div class="head-sym"><WorkSymbol id={work.id} genre={work.genre} size={104} title={work.title} /></div>
    <div>
      <span class="side-chip" style={`background:${sides[c.side].color}`}>{sides[c.side].label}</span>
      <h1>{c.name}</h1>
      <p class="muted kana">{c.kana}</p>
      <p class="role">{c.role}{c.affil && <span class="muted"> / {c.affil}</span>}</p>
      <p class="muted from">
        『<a href={`${base}works/${work.id}/`}>{work.title}</a>』({work.year}年)の登場人物
      </p>
      <button class="read-toggle" type="button" data-work={work.id} aria-pressed="false">
        <span class="read-toggle-label">読了にする</span>
      </button>
    </div>
  </header>

  <h2 class="section-title">人物</h2>
  <p class="bio">{c.bio}</p>

  {c.actor && (
    <p class="cast card">🎬 {c.actor}</p>
  )}

  {c.notes.length > 0 && (
    <>
      <h2 class="section-title">この人物をめぐる出来事</h2>
      <p class="muted lead-note">
        以下は該当する作品を読了にすると表示されます(個別にタップして開くこともできます)。
      </p>
      <ul class="notes">
        {c.notes.map((n) => (
          <li class="note card" data-sp={n.sp}>
            <p>{n.text}</p>
          </li>
        ))}
      </ul>
    </>
  )}

  {mates.length > 0 && (
    <>
      <h2 class="section-title">同じ作品の人物</h2>
      <ul class="mates">
        {mates.map((m) => (
          <li>
            <a href={`${base}characters/${m.id}/`}>{m.name}</a>
            <span class="muted"> — {m.role}</span>
          </li>
        ))}
      </ul>
      <p class="muted"><a href={`${base}relations/`}>人物相関図で関係を見る →</a></p>
    </>
  )}
</Base>

<style>
  .crumbs { font-size: 0.82rem; margin-bottom: 10px; }
  .char-head { display: flex; gap: 20px; align-items: flex-start; margin-bottom: 8px; }
  .head-sym { flex: none; line-height: 0; }
  h1 { margin: 6px 0 2px; font-size: 1.6rem; }
  .kana { font-size: 0.8rem; margin: 0 0 6px; }
  .role { margin: 0 0 4px; font-size: 0.95rem; }
  .from { font-size: 0.84rem; margin: 0 0 10px; }
  .side-chip {
    color: #fff;
    font-size: 0.72rem;
    font-weight: 700;
    padding: 0.15em 0.7em;
    border-radius: 999px;
    display: inline-block;
  }
  .bio { font-size: 0.98rem; }
  .cast { padding: 10px 14px; font-size: 0.88rem; margin: 12px 0; }
  .lead-note { font-size: 0.84rem; margin-top: -0.4rem; }
  .notes { list-style: none; padding: 0; display: grid; gap: 10px; }
  .note { padding: 13px 16px; }
  .note p { margin: 0; }
  .mates { list-style: none; padding: 0; display: grid; gap: 4px; }
  .mates li { font-size: 0.93rem; }

  @media (max-width: 560px) {
    .char-head { flex-direction: column; gap: 12px; }
  }
</style>
