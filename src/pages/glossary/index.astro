---
import Base from '../../layouts/Base.astro';
import glossaryData from '../../data/glossary.json';
import worksData from '../../data/works.json';

const base = import.meta.env.BASE_URL;
const workById = Object.fromEntries(worksData.works.map((w) => [w.id, w]));
const total = glossaryData.categories.reduce((n, c) => n + c.terms.length, 0);
---

<Base title="用語集" description="貴志祐介の作品に出てくる鍵になる言葉を作品別に。まだ読んでいない作品の語はぼかして表示されます。">
  <h1>用語集</h1>
  <p class="muted">
    作品を読み解く鍵になる言葉を{total}語。<strong>まだ読了にしていない作品の語はぼかして表示されます</strong>(タップすればその語だけ開けます)。
  </p>

  <nav class="toc">
    {glossaryData.categories.map((c) => (
      <a href={`#${encodeURIComponent(c.category)}`}>{c.category}</a>
    ))}
  </nav>

  {glossaryData.categories.map((c) => (
    <section class="cat">
      <h2 class="section-title" id={c.category}>
        {c.work ? <a href={`${base}works/${c.work}/`}>{c.category}</a> : c.category}
        <span class="muted cat-count">{c.terms.length}語</span>
      </h2>
      <dl class="terms">
        {c.terms.map((t) => (
          <div class="term card" data-sp={t.sp}>
            <dt>
              {t.term}
              <span class="muted term-kana">{t.kana}</span>
              <a class="term-src" href={`${base}works/${t.sp}/`}>『{workById[t.sp]?.title ?? t.sp}』</a>
            </dt>
            <dd>{t.desc}</dd>
          </div>
        ))}
      </dl>
    </section>
  ))}
</Base>

<style>
  h1 { margin-bottom: 0.3rem; }
  .toc {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 16px 0 4px;
  }
  .toc a {
    font-size: 0.82rem;
    text-decoration: none;
    border: 1px solid var(--line);
    border-radius: 999px;
    padding: 4px 13px;
  }
  .toc a:hover { border-color: var(--accent); color: var(--accent); }
  .cat-count { font-size: 0.76rem; font-weight: 400; margin-left: auto; }
  .section-title a { text-decoration: none; }
  .section-title a:hover { color: var(--accent); }

  .terms { display: grid; gap: 10px; margin: 0; }
  .term { padding: 13px 16px; }
  .term dt {
    font-weight: 700;
    font-size: 1rem;
    display: flex;
    align-items: baseline;
    gap: 8px;
    flex-wrap: wrap;
  }
  .term-kana { font-size: 0.74rem; font-weight: 400; }
  .term-src {
    font-size: 0.74rem;
    font-weight: 400;
    margin-left: auto;
    text-decoration: none;
    color: var(--ink-2);
  }
  .term-src:hover { color: var(--accent); }
  .term dd { margin: 6px 0 0; font-size: 0.9rem; }
</style>
